{
  "component": "decide",
  "type": "skill",
  "version": "3.0",
  "preregistered": "2026-08-03",
  "notes": "PRE-REGISTERED BEFORE THE REBUILD. v3 is the simplified team decision framework: frame + classify door -> each member answers the 10 principles -> aggregate -> 3-model panel running BOTH a game-theory lens and a Hegelian dialectic lens -> recommendation brief + one ledger row. Cases are in three tiers. STATIC cases check the skill's artifacts with deterministic string/regex checks (no model, no network). RUNTIME cases execute scripts/panel.py and scripts/ledger.py against the frozen fixtures in evals/fixtures/ and check the produced artifacts and run log. JUDGE cases replay 5 synthetic historical decisions whose known-good outcomes are frozen in the fixture files and score the produced brief with gpt-5.6-sol, threshold 4.0/5. Runner: python3 evals/run.py --all. Gold answers and thresholds: evals/GOLD.md.",
  "ledger_row_regex": "^\\| \\d{4}-\\d{2}-\\d{2} \\| [^|]{3,120} \\| (1-way|2-way) \\| (GO|NO-GO|MODIFY|DEFER) \\| [^|]{1,60} \\| outcome:pending \\|$",
  "judge_model": "gpt-5.6-sol",
  "judge_threshold": 4.0,
  "panel_models": ["claude-fable-5", "gpt-5.6-sol", "grok-4.5"],
  "cases": [

    {
      "id": "s01-frontmatter-valid",
      "tier": "static",
      "category": "functional",
      "description": "SKILL.md has valid frontmatter with name and description",
      "input": {"target": "SKILL.md"},
      "expected": {"regex": ["(?s)^---\\n.*?^name: decide$.*?^description: .{40,}$.*?^---$"]},
      "metrics": ["ConfigParsing", "OutputValidity"]
    },
    {
      "id": "s02-progressive-disclosure",
      "tier": "static",
